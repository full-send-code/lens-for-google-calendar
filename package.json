{
  "name": "lens-for-google-calendar",
  "version": "2.0.0",
  "description": "Save and restore groups of calendars in Google Calendar",
  "main": "dist/background.js",
  "scripts": {
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "dev": "vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "chrome-extension",
    "google-calendar",
    "calendar",
    "productivity"
  ],
  "author": "full-send-code",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.1",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.14",
    "@types/loglevel": "^1.5.4",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^5.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "antd": "^5.28.0",
    "loglevel": "^1.9.2",
    "mousetrap": "^1.6.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
